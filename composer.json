{
    "name": "kalimeromk/filament-page-builder",
    "description": "Open-source Elementor Pro-like visual page builder plugin for Laravel & Filament v5.",
    "keywords": [
        "KalimeroMK",
        "laravel",
        "filament",
        "filament-plugin",
        "page-builder",
        "visual-builder",
        "elementor",
        "livewire"
    ],
    "homepage": "https://github.com/KalimeroMK/filament-page-builder",
    "support": {
        "issues": "https://github.com/KalimeroMK/filament-page-builder/issues",
        "source": "https://github.com/KalimeroMK/filament-page-builder"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "KalimeroMK",
            "email": "zbogoevski@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0|^14.0",
        "illuminate/support": "^12.0|^13.0|^14.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "KalimeroMK\\FilamentPageBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KalimeroMK\\FilamentPageBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KalimeroMK\\FilamentPageBuilder\\FilamentPageBuilderServiceProvider"
            ],
            "aliases": {
                "PageBuilder": "KalimeroMK\\FilamentPageBuilder\\Facades\\PageBuilder"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
